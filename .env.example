# Copy to .env and fill in real values. Never commit .env.
# See SECURITY.md for handling guidance.

# Postgres connection string used by Payload CMS
DATABASE_URI=postgresql://postgres:PASSWORD@127.0.0.1:5432/al_harraz

# Long random string used to sign Payload auth tokens. Generate with:
#   openssl rand -base64 48
PAYLOAD_SECRET=

# Public site URL, used to build absolute URLs (sitemap, OG tags, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp / phone numbers (public, safe to expose client-side)
NEXT_PUBLIC_FIRM_PHONE=+201005029501
NEXT_PUBLIC_FIRM_WHATSAPP=201005029501

# Analytics (leave empty until approved for production — see SECURITY.md)
NEXT_PUBLIC_GA4_ID=

# Search Console verification code — from search.google.com/search-console,
# "HTML tag" verification method, just the content="..." value (not the
# whole tag). Leave empty until Search Console is set up.
GOOGLE_SITE_VERIFICATION=

# Shared secret checked against the Authorization: Bearer header Vercel's
# cron scheduler sends automatically when it calls /api/cron/backup — see
# BACKUPS.md. Generate with: openssl rand -base64 32
CRON_SECRET=

# Vercel Blob read/write token, used by the daily content-backup cron to
# upload the JSON export. Auto-injected by Vercel when a Blob store is
# connected to the project (Storage tab) — not needed for local dev unless
# testing the backup route locally against a real Blob store.
BLOB_READ_WRITE_TOKEN=

# Explicit override for whether this deployment should be indexable by
# search engines. On Vercel this is auto-detected from VERCEL_ENV
# (production = indexable, preview/development = noindex) and this var
# does not need to be set. Set it explicitly ("true" or "false") only on a
# non-Vercel host (e.g. Netlify — see ZERO_COST_HOSTING.md) or to force a
# specific deployment off/on indexing regardless of environment. See
# src/lib/indexing.ts.
SITE_INDEXABLE=
